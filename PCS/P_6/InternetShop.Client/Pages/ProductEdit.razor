@page "/products/add"
@page "/products/edit/{Id:int}"
@inject ProductApiService Api
@inject NavigationManager Nav

<PageTitle>@(_isEdit ? "Изменить товар" : "Новый товар")</PageTitle>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="">Товары</a></li>
        <li class="breadcrumb-item active">@(_isEdit ? "Изменение" : "Добавление")</li>
    </ol>
</nav>

<div class="page-header mb-4">
    <h1 class="h3 fw-bold">@(_isEdit ? "Изменить товар" : "Добавить товар")</h1>
</div>

@if (_loading)
{
    <div class="panel-card text-center py-4">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="panel-card form-panel">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" />

            <div class="mb-3">
                <label class="form-label">Название</label>
                <InputText class="form-control" @bind-Value="_model.Name" />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Описание</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="_model.Description" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Цена, ₽</label>
                    <InputNumber class="form-control" @bind-Value="_model.Price" />
                    <ValidationMessage For="() => _model.Price" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Остаток, шт.</label>
                    <InputNumber class="form-control" @bind-Value="_model.Stock" />
                    <ValidationMessage For="() => _model.Stock" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Категория</label>
                    <InputText class="form-control" @bind-Value="_model.Category" />
                    <ValidationMessage For="() => _model.Category" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    @(_saving ? "Сохранение..." : "Сохранить")
                </button>
                <a class="btn btn-outline-secondary" href="">Отмена</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Product _model = new();
    private bool _isEdit;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _isEdit = Id > 0;
        _loading = true;
        _error = null;

        if (_isEdit)
        {
            var product = await Api.GetByIdAsync(Id);
            if (product is null)
            {
                _error = "Товар не найден.";
            }
            else
            {
                _model = new Product
                {
                    Id = product.Id,
                    Name = product.Name,
                    Description = product.Description,
                    Price = product.Price,
                    Stock = product.Stock,
                    Category = product.Category
                };
            }
        }
        else
        {
            _model = new Product { Stock = 1, Category = "Общее" };
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var ok = _isEdit
                ? await Api.UpdateAsync(_model)
                : await Api.CreateAsync(_model) is not null;

            if (ok)
            {
                Nav.NavigateTo("");
                return;
            }

            _error = "Не удалось сохранить товар. Проверьте данные.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
