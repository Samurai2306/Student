<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Туристический путеводитель</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TouristGuide.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Туристический путеводитель</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <div class="global-search-wrap mx-lg-3 my-2 my-lg-0 flex-grow-1 position-relative">
                        <input type="search" id="globalSearch" class="form-control form-control-sm global-search-input"
                               placeholder="Быстрый поиск города или места..." autocomplete="off" />
                        <div id="searchResults" class="search-results-panel"></div>
                    </div>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cities" asp-action="Index">Города</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Attractions" asp-action="Index">Места</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Guide" asp-action="Map">Карта</a></li>
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Guide" asp-action="Planner">
                                Маршрут
                                <span id="navRouteBadge" class="nav-count-badge d-none">0</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container text-center">
            &copy; @DateTime.Now.Year — Практическое занятие №4, интерактивный туристический путеводитель
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/guide.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
