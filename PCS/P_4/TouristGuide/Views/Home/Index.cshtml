@model TouristGuide.ViewModels.DashboardViewModel
@using TouristGuide.Helpers
@{
    ViewData["Title"] = "Главная";
}

<section class="hero-panel hero-interactive mb-4">
    <div class="hero-panel-content">
        <p class="hero-kicker mb-2">Интерактивный путеводитель</p>
        <h1 class="display-5 fw-bold mb-2">Откройте Россию</h1>
        <p class="lead mb-4">Карта, маршрут, избранное и умный поиск — всё в одном приложении.</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Guide" asp-action="Map" class="btn btn-light btn-lg">Интерактивная карта</a>
            <a asp-controller="Guide" asp-action="Planner" class="btn btn-outline-light btn-lg">Мой маршрут</a>
            <a asp-controller="Cities" asp-action="Index" class="btn btn-outline-light">Города</a>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="kpi-card"><div class="kpi-value">@Model.CitiesCount</div><div class="kpi-label">@DisplayFormat.Pluralize(Model.CitiesCount, "город", "города", "городов")</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-accent"><div class="kpi-value">@Model.AttractionsCount</div><div class="kpi-label">@DisplayFormat.Pluralize(Model.AttractionsCount, "место", "места", "мест")</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card"><div class="kpi-value">@Model.RegionsCount</div><div class="kpi-label">@DisplayFormat.Pluralize(Model.RegionsCount, "регион", "региона", "регионов")</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="kpi-card kpi-ok"><div class="kpi-value">@Model.FreeAttractionsCount</div><div class="kpi-label">бесплатных входов</div></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="content-section h-100 discovery-panel">
            <h2 class="section-title">Куда поехать?</h2>
            <p class="text-muted">Случайная достопримечательность — нажмите и получите идею для путешествия.</p>
            <button type="button" class="btn btn-primary mb-3" id="btnRandomPlace">Случайное место</button>
            <div id="randomPlaceCard" class="random-place-box text-muted small">Нажмите кнопку, чтобы увидеть предложение</div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-section h-100">
            <h2 class="section-title">Как пользоваться</h2>
            <ol class="guide-steps mb-0 ps-3">
                <li class="mb-2">Ищите в <strong>строке поиска</strong> в шапке — города и места без перезагрузки.</li>
                <li class="mb-2">Отмечайте <strong>избранное</strong> и собирайте <strong>маршрут</strong> кнопкой «+ В маршрут».</li>
                <li class="mb-2">Смотрите всё на <a asp-controller="Guide" asp-action="Map">интерактивной карте</a>.</li>
                <li>Бюджет поездки считается автоматически в <a asp-controller="Guide" asp-action="Planner">планировщике</a>.</li>
            </ol>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="content-section h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="section-title mb-0">Крупнейшие города</h2>
                <a asp-controller="Cities" asp-action="Index" asp-route-sort="population-desc" class="btn btn-sm btn-outline-primary">Все города</a>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-3">
                @foreach (var city in Model.TopCities)
                {
                    <div class="col"><partial name="_CityCard" model="city" /></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-section h-100">
            <h2 class="section-title">Быстрые действия</h2>
            <div class="d-grid gap-2">
                <a asp-controller="Guide" asp-action="Map" class="btn btn-primary">Карта России</a>
                <a asp-controller="Guide" asp-action="Planner" class="btn btn-outline-primary">Планировщик маршрута</a>
                <a asp-controller="Attractions" asp-action="Index" asp-route-fee="free" class="btn btn-outline-success">Бесплатные места</a>
                <a asp-controller="Attractions" asp-action="Index" class="btn btn-outline-secondary">Каталог мест</a>
            </div>
        </div>
    </div>
</div>

<section class="content-section">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="section-title mb-0">Популярные места</h2>
        <a asp-controller="Attractions" asp-action="Index" class="btn btn-sm btn-outline-primary">Смотреть все</a>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var attraction in Model.FeaturedAttractions)
        {
            <div class="col"><partial name="_AttractionCard" model="attraction" /></div>
        }
    </div>
</section>
