@model ProductionSystem.ViewModels.LinesIndexViewModel
@using ProductionSystem.Models
@{
    ViewData["Title"] = "Производственные линии";
}

<div class="page-header mb-4">
    <h1 class="h3 fw-bold">Интерактивная панель линий</h1>
    <p class="text-muted mb-0">Статус линий, прогресс заказов, эффективность и расписание.</p>
</div>

@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }

<div class="row g-4">
    @foreach (var line in Model.Lines)
    {
        var isActive = line.Status == ProductionLine.StatusActive;
        var current = line.CurrentWorkOrder;
        <div class="col-xl-6">
            <div class="line-card @(isActive ? "line-active" : "line-stopped")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="h5 mb-1">@line.Name</h2>
                        <span class="line-status @(isActive ? "text-success" : "text-secondary")">
                            @(isActive ? "Работает" : "Остановлена")
                        </span>
                    </div>
                    <span class="badge text-bg-light border">k = @line.EfficiencyFactor.ToString("0.0")</span>
                </div>

                @if (current is not null)
                {
                    <div class="mb-3" data-order-progress data-order-id="@current.Id">
                        <div class="small text-muted">Текущий продукт</div>
                        <div class="fw-semibold">@current.Product?.Name</div>
                        <div class="progress mt-2 order-progress" style="height: 10px;" role="progressbar"
                             aria-valuenow="@current.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" data-progress-bar
                                 style="width: @current.ProgressPercent%"></div>
                        </div>
                        <div class="small mt-1 d-flex justify-content-between flex-wrap gap-1">
                            <span>Прогресс: <strong data-progress-label>@current.ProgressPercent</strong>%</span>
                            <span class="text-muted" data-progress-eta>Окончание: @current.EstimatedEndDate.ToString("dd.MM HH:mm")</span>
                        </div>
                        <p class="small text-muted mb-0 mt-1">Увеличивается автоматически по плану до 100%</p>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-2">Линия свободна</p>
                    @if (isActive && Model.Products.Any())
                    {
                        <form asp-action="QuickStart" method="post" class="quick-start-form mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="LineId" value="@line.Id" />
                            <div class="small text-muted mb-1">Быстрый запуск — создать и сразу начать заказ</div>
                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                <div class="flex-grow-1" style="min-width:140px">
                                    <label class="form-label small mb-0">Продукт</label>
                                    <select name="ProductId" class="form-select form-select-sm">
                                        @foreach (var product in Model.Products)
                                        {
                                            <option value="@product.Id">@product.Name</option>
                                        }
                                    </select>
                                </div>
                                <div style="width:80px">
                                    <label class="form-label small mb-0">Кол-во</label>
                                    <input type="number" name="Quantity" value="1" min="1" class="form-control form-control-sm" />
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary">Запустить</button>
                            </div>
                        </form>
                    }
                }

                <div class="line-actions d-flex flex-wrap gap-2 mb-3">
                    @if (isActive)
                    {
                        <form asp-action="StopLine" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lineId" value="@line.Id" />
                            <button class="btn btn-sm btn-outline-danger">Остановить</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="SetStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lineId" value="@line.Id" />
                            <input type="hidden" name="status" value="@ProductionLine.StatusActive" />
                            <button class="btn btn-sm btn-success">Запустить линию</button>
                        </form>
                    }

                    @{
                        var lineOrders = Model.PendingOrders.Where(o => o.ProductionLineId == null || o.ProductionLineId == line.Id).ToList();
                    }
                    @if (lineOrders.Any() && current is null && isActive)
                    {
                        <form asp-action="StartOrder" method="post" class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lineId" value="@line.Id" />
                            <select name="orderId" class="form-select form-select-sm" style="width:auto">
                                @foreach (var order in lineOrders)
                                {
                                    <option value="@order.Id">#@order.Id @order.Product.Name</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-primary">Запустить заказ</button>
                        </form>
                    }
                </div>

                <form asp-action="SetEfficiency" method="post" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LineId" value="@line.Id" />
                    <div class="col-8">
                        <label class="form-label small">Коэфф. эффективности (0.5–2.0)</label>
                        <input type="number" name="EfficiencyFactor" value="@line.EfficiencyFactor.ToString("0.0")" min="0.5" max="2" step="0.1" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4">
                        <button class="btn btn-sm btn-outline-primary w-100">Сохранить</button>
                    </div>
                </form>

                <h3 class="h6">Расписание</h3>
                @if (!line.WorkOrders.Any())
                {
                    <p class="text-muted small mb-0">Нет назначенных заказов</p>
                }
                else
                {
                    <ul class="list-group list-group-flush schedule-list">
                        @foreach (var order in line.WorkOrders.OrderBy(o => o.StartDate))
                        {
                            <li class="list-group-item px-0">
                                <div class="d-flex justify-content-between">
                                    <span>#@order.Id · @order.Product.Name · @order.Quantity шт.</span>
                                    <span class="small">@order.StartDate.ToString("dd.MM HH:mm")</span>
                                </div>
                                <form asp-action="Reschedule" method="post" class="row g-1 mt-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="OrderId" value="@order.Id" />
                                    <div class="col-8">
                                        <input type="datetime-local" name="NewStartDate" class="form-control form-control-sm"
                                               value="@order.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                                    </div>
                                    <div class="col-4">
                                        <button class="btn btn-sm btn-outline-secondary w-100">Перенести</button>
                                    </div>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/order-progress.js" asp-append-version="true"></script>
}
