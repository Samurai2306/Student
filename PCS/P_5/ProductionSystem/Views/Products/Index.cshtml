@model ProductionSystem.ViewModels.ProductsIndexViewModel

@{

    ViewData["Title"] = "Продукты";

    var editMode = ViewData["EditMode"] as bool? == true;

}



<div class="page-header mb-4">

    <h1 class="h3 fw-bold">Панель продуктов</h1>

    <p class="text-muted mb-0">Каталог изделий, время производства и привязка материалов.</p>

</div>



@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }

@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }



<div class="row g-4">

    <div class="col-xl-8">

        <div class="panel-card mb-3">

            <form method="get" class="row g-2 align-items-end">

                <div class="col-md-5">

                    <label class="form-label">Категория</label>

                    <select name="category" class="form-select">

                        <option value="">Все категории</option>

                        @foreach (var cat in Model.Categories)

                        {

                            <option value="@cat" selected="@(Model.Category == cat)">@cat</option>

                        }

                    </select>

                </div>

                <div class="col-md-5">

                    <label class="form-label">Поиск</label>

                    <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Название продукта" />

                </div>

                <div class="col-md-2">

                    <button type="submit" class="btn btn-outline-primary w-100">Фильтр</button>

                </div>

            </form>

        </div>



        <div class="panel-card">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Название</th>

                            <th>мин/шт</th>

                            <th>Категория</th>

                            <th>Мин. запас</th>

                            <th>Материалов</th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var product in Model.Products)

                        {

                            <tr>

                                <td>@product.Name</td>

                                <td>@product.ProductionTimePerUnit</td>

                                <td><span class="badge text-bg-light border">@product.Category</span></td>

                                <td>@product.MinimalStock</td>
                                <td>@product.ProductMaterials.Count</td>

                                <td><a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Изменить</a></td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <div class="col-xl-4">

        <div class="panel-card @(editMode ? "border-primary" : string.Empty)">

            <h2 class="h5 mb-3">@(editMode ? "Редактировать продукт" : "Создать продукт")</h2>

            <form asp-action="@(editMode ? "Edit" : "Create")" method="post">

                @Html.AntiForgeryToken()

                @if (editMode)

                {

                    <input type="hidden" asp-for="Form.Id" />

                }

                <div class="mb-2"><label class="form-label">Название</label><input asp-for="Form.Name" class="form-control" /></div>

                <div class="mb-2"><label class="form-label">Категория</label><input asp-for="Form.Category" class="form-control" /></div>

                <div class="mb-2"><label class="form-label">Описание</label><textarea asp-for="Form.Description" class="form-control" rows="2"></textarea></div>

                <div class="mb-2"><label class="form-label">JSON характеристики</label><textarea asp-for="Form.Specifications" class="form-control" rows="2"></textarea></div>

                <div class="row g-2 mb-3">

                    <div class="col-6"><label class="form-label">Время (мин/шт)</label><input asp-for="Form.ProductionTimePerUnit" class="form-control" /></div>

                    <div class="col-6"><label class="form-label">Мин. запас</label><input asp-for="Form.MinimalStock" class="form-control" /></div>

                </div>



                <h3 class="h6">Материалы для производства</h3>

                @for (var i = 0; i < Model.Form.Materials.Count; i++)

                {

                    <div class="border rounded p-2 mb-2">

                        <input type="hidden" asp-for="Form.Materials[i].MaterialId" />

                        <input type="hidden" asp-for="Form.Materials[i].MaterialName" />

                        <div class="form-check">

                            <input class="form-check-input" asp-for="Form.Materials[i].Selected" />

                            <label class="form-check-label">@Model.Form.Materials[i].MaterialName</label>

                        </div>

                        <input asp-for="Form.Materials[i].QuantityNeeded" class="form-control form-control-sm mt-1" placeholder="Кол-во на 1 шт." />

                    </div>

                }



                <button type="submit" class="btn btn-primary w-100">@(editMode ? "Сохранить" : "Создать продукт")</button>

                @if (editMode)

                {

                    <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Отмена</a>

                }

            </form>

        </div>

    </div>

</div>


