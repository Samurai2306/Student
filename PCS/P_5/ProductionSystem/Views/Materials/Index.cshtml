@model ProductionSystem.ViewModels.MaterialsIndexViewModel

@{

    ViewData["Title"] = "Материалы";

}



<div class="page-header mb-4">

    <h1 class="h3 fw-bold">Панель материалов</h1>

    <p class="text-muted mb-0">Учёт сырья, контроль минимального запаса и быстрое пополнение склада.</p>

</div>



@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }

@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }



@if (Model.LowStockCount > 0)

{

    <div class="alert alert-warning">

        Внимание: @Model.LowStockCount материал(ов) ниже минимального запаса.

        <a asp-action="Index" asp-controller="Materials">Показать</a>

    </div>

}



<div class="row g-4">

    <div class="col-xl-8">

        <div class="panel-card">

            <h2 class="h5 mb-3">Склад материалов</h2>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Название</th>

                            <th>Количество</th>

                            <th>Ед. изм.</th>

                            <th>Мин. запас</th>

                            <th>Пополнить</th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Materials)

                        {

                            <tr class="@(item.IsLowStock ? "table-warning" : string.Empty)">

                                <td>@item.Name</td>

                                <td><span class="@(item.IsLowStock ? "text-danger fw-bold" : string.Empty)">@item.Quantity.ToString("0.##")</span></td>

                                <td>@item.UnitOfMeasure</td>

                                <td>@item.MinimalStock.ToString("0.##")</td>

                                <td>

                                    <form asp-action="Replenish" method="post" class="d-flex gap-2 align-items-center">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="MaterialId" value="@item.Id" />

                                        <input type="number" name="Amount" value="10" min="0.01" step="0.01" class="form-control form-control-sm" style="width:90px" />

                                        <button type="submit" class="btn btn-sm btn-success">Пополнить</button>

                                    </form>

                                </td>

                                <td><a asp-action="Index" asp-route-editId="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a></td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <div class="col-xl-4">

        @if (Model.EditMaterial is not null)

        {

            <div class="panel-card mb-4 border-primary">

                <h2 class="h5 mb-3">Редактировать материал</h2>

                <form asp-action="Edit" method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="EditMaterial.Id" />

                    <div class="mb-2"><label class="form-label">Название</label><input asp-for="EditMaterial.Name" class="form-control" /></div>

                    <div class="mb-2"><label class="form-label">Количество</label><input asp-for="EditMaterial.Quantity" class="form-control" /></div>

                    <div class="mb-2"><label class="form-label">Ед. изм.</label><input asp-for="EditMaterial.UnitOfMeasure" class="form-control" /></div>

                    <div class="mb-3"><label class="form-label">Мин. запас</label><input asp-for="EditMaterial.MinimalStock" class="form-control" /></div>

                    <button type="submit" class="btn btn-primary w-100 mb-2">Сохранить изменения</button>

                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Отмена</a>

                </form>

            </div>

        }



        <div class="panel-card">

            <h2 class="h5 mb-3">Добавить материал</h2>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3"><label class="form-label">Название</label><input asp-for="NewMaterial.Name" class="form-control" /><span asp-validation-for="NewMaterial.Name" class="text-danger small"></span></div>

                <div class="mb-3"><label class="form-label">Текущее количество</label><input asp-for="NewMaterial.Quantity" class="form-control" /></div>

                <div class="mb-3"><label class="form-label">Единица измерения</label><input asp-for="NewMaterial.UnitOfMeasure" class="form-control" /></div>

                <div class="mb-3"><label class="form-label">Минимальный запас</label><input asp-for="NewMaterial.MinimalStock" class="form-control" /></div>

                <button type="submit" class="btn btn-primary w-100">Добавить</button>

            </form>

        </div>

    </div>

</div>



@section Scripts { <partial name="_ValidationScriptsPartial" /> }


